{
  "name": "Scoutly - Matches diarios (HU-06 + HU-11, ingesta real)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-trigger-1",
      "name": "Cada día a las 6am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.containers.internal:8000/api/importar-vacantes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scoutly-Token",
              "value": "dev-local-token-change-me"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-request-0",
      "name": "0. Importar vacantes (ingesta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://host.containers.internal:8000/api/estado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scoutly-Token",
              "value": "dev-local-token-change-me"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-estado-ingesta",
      "name": "Estado de la ingesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ingesta-terminada",
              "leftValue": "={{ $json.ingesta_en_curso }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ingesta",
      "name": "¿Terminó la ingesta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-ingesta",
      "name": "Esperar 30 s (ingesta)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [900, 500],
      "webhookId": "scoutly-espera-ingesta"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.containers.internal:8000/api/decidir",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scoutly-Token",
              "value": "dev-local-token-change-me"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-request-1",
      "name": "1. Decidir (encolar para el batch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "url": "http://host.containers.internal:8000/api/estado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scoutly-Token",
              "value": "dev-local-token-change-me"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-estado-cola",
      "name": "Estado de la cola",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cola-vacia",
              "leftValue": "={{ $json.cola }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-cola",
      "name": "¿Se vació la cola?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "id": "wait-cola",
      "name": "Esperar 15 s (cola)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 500],
      "webhookId": "scoutly-espera-cola"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.containers.internal:8000/api/generar-notificaciones",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Scoutly-Token",
              "value": "dev-local-token-change-me"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-request-2",
      "name": "2. Generar notificaciones",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300]
    }
  ],
  "connections": {
    "Cada día a las 6am": {
